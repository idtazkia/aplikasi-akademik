#!/bin/bash
# Database credentials for production server
# Copy this file to db-credentials.sh and fill in actual values
# db-credentials.sh is gitignored

export DB_SSH_HOST="<server-ip>"
export DB_SSH_USER="<ssh-username>"
export DB_NAME="<database-name>"
export DB_USER="<db-username>"
export DB_PASS="<db-password>"
